# ============================================================
# Study Buddy Roulette - Backend Environment Variables Example
# Duplicate this file to .env and provide your actual secrets.
# NEVER commit the real .env file to version control!
# ============================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Clusters -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/study_buddy_roulette?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/study_buddy_roulette?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random key, at least 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# JWT Expiration Period (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for Strict CORS Configuration
CLIENT_URL=http://localhost:5173

# Frontend Verification Base URL (Used for generating verification email links)
FRONTEND_URL=http://localhost:5173

# ============================================================
# Email Verification & SMTP Configuration (Nodemailer)
# ============================================================
# SMTP Host (e.g., smtp.gmail.com, smtp.mailtrap.io, smtp.sendgrid.net)
SMTP_HOST=smtp.mailtrap.io

# SMTP Port (587 for STARTTLS, 465 for SSL/TLS, 2525 for Mailtrap sandbox)
SMTP_PORT=587

# Use direct SSL/TLS (set true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Account Username / API Key
SMTP_USER=your_smtp_username_or_api_key

# SMTP Account Password / App Password
SMTP_PASS=your_smtp_password_or_app_password

# Sender Address & Display Name
EMAIL_FROM="Study Buddy Roulette" <noreply@studybuddyroulette.edu>

